# =============================================================================
# FAQ Extraction Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#
# Authentication: This pipeline uses Google Cloud Application Default Credentials.
# Run: gcloud auth application-default login

# -----------------------------------------------------------------------------
# Google Cloud Configuration (required)
# -----------------------------------------------------------------------------
# Your GCP project ID - used for Vertex AI embeddings and Anthropic Claude
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=europe-west1

# Vertex AI location for embeddings (optional, defaults to europe-west1)
VERTEX_AI_LOCATION=europe-west1

